# Server Port
PORT=3001

# Destination (Where inquiry emails arrive)
CONTACT_RECEIVER_EMAIL=info@blackgateitsolutions.co.in

# -------------------------------------------------------------
# GMAIL CONFIGURATION
# -------------------------------------------------------------
# 1. Your Gmail address or Google Workspace address:
SMTP_USER=your-email@gmail.com

# 2. Your 16-character Google App Password (NOT your normal password)
# Generated from: https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx xxxx xxxx xxxx

# Optional overrides (automatically detected for Gmail):
# SMTP_SERVICE=gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Admin Secret Key for Poll Dashboard (/admin/poll)
ADMIN_KEY=blackgate-admin-2026
