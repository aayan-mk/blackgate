# Server Configuration
PORT=3001

# Recipient Email (Where inquiries are delivered)
CONTACT_RECEIVER_EMAIL=info@blackgateitsolutions.co.in

# SMTP Email Dispatch Credentials
# For Gmail: Use smtp.gmail.com with port 587 and an App Password (not your normal password)
# For Hostinger: Use smtp.hostinger.com with port 465 or 587
# For Zoho / Google Workspace / Outlook: Configure matching host and credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
